    "dotenv": "^18.0.10",
    "embla-carousel-react": "^8.6.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.71.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
