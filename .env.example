# Caminho do banco SQLite (relativo à raiz do projeto)
DATABASE_URL="file:./prisma/dev.db"
# Chave para assinar o cookie de sessão da equipe (mín. 32 caracteres)
# Gere com: openssl rand -base64 32
SESSION_SECRET="troque-por-uma-string-aleatoria-de-32-caracteres"

# Somente no deploy (Vercel): banco SQLite na nuvem do Turso.
# Com estas variáveis definidas o app ignora DATABASE_URL.
# TURSO_DATABASE_URL="libsql://seu-banco.turso.io"
# TURSO_AUTH_TOKEN="..."
